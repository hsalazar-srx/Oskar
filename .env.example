# OSKAR — Environment Variables Example (PRE-11)
# Copy to .env for local development:  cp .env.example .env
# Fill in real values in .env — it is gitignored and never committed.
#
# Production: DO NOT use this file.
# Run scripts/setup-server-secrets.sh on the OSKAR Linux VM.
# Secrets are written to /etc/oskar/secrets.env (owner root:oskar-app, mode 0640).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
OSKAR_DB_HOST=localhost
OSKAR_DB_PORT=5432
OSKAR_DB_NAME=oskar
OSKAR_DB_USER=oskar_app
OSKAR_DB_PASSWORD=change-me-dev-only

# ── JWT ───────────────────────────────────────────────────────────────────────
# ADR-006: 60-min access token, 8h HttpOnly refresh cookie
# Generate key: openssl rand -hex 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_HOURS=8

# ── Redis — ELIMINATED (ADR-007) ──────────────────────────────────────────────
# Redis has been removed from the OSKAR stack. Replacements:
#   Celery broker    → celery[sqlalchemy] (DATABASE_URL as broker)
#   JTI blocklist    → jti_blocklist table in PostgreSQL
#   Refresh tokens   → refresh_tokens table in PostgreSQL
#   Event stream     → HTTP polling GET /api/v1/ecn/{id} (15–30s)
# No REDIS_* variables required.

# ── Active Directory ──────────────────────────────────────────────────────────
# ADR-006: LDAPS on 636 is required at go-live. LDAP_USE_TLS=false + ldap:// on
# 389 is permitted ONLY during the pre-go-live test window — it puts the service
# account and every user password on the wire in the clear.
# AUTH_PROVIDER: "ldap" (production) | "dev" (local bypass) | "entra" (future, PRE-3)
AUTH_PROVIDER=ldap
LDAP_SERVER=ldaps://srxdc01.srxglobal.com
LDAP_PORT=636
LDAP_USE_TLS=true
LDAP_BASE_DN=DC=srxglobal,DC=com
LDAP_BIND_DN=CN=svc-oskar-ldap,OU=Managed Service Accounts,DC=srxglobal,DC=com
LDAP_BIND_PW=change-me-dev-only

# Application Role groups live under
#   OU=Application Roles,OU=Groups,DC=srxglobal,DC=com
# and are resolved through nesting: Business Function groups (grp-*) are members
# of the ECN roles, so membership is walked with LDAP_MATCHING_RULE_IN_CHAIN
# rather than read from the user's memberOf. No group name is configured here —
# the roles are whatever that OU contains (ecn-initiator, ecn-approver,
# ecn-doc-controller).

# scripts/ldap_verify.py — a user whose ECN role comes ONLY via a nested
# Business Function group, and one added directly (e.g. an ecn-doc-controller).
# Without both, nesting is UNVERIFIED and preflight reports INCOMPLETE.
LDAP_VERIFY_NESTED_USER=
LDAP_VERIFY_DIRECT_USER=

# ── Celery ────────────────────────────────────────────────────────────────────
# ADR-005: task signing key — generate: openssl rand -hex 32
CELERY_SECURITY_KEY=change-me-generate-with-openssl-rand-hex-32

# ── SMTP (Sprint 2 — PRE-9) ──────────────────────────────────────────────────
# Confirm SMTP host, port, and sender with Infrastructure before Sprint 2
SMTP_HOST=smtp.srxglobal.local
SMTP_PORT=587
SMTP_FROM=oskar-noreply@srxglobal.local
SMTP_PASSWORD=change-me-dev-only

# ── ERP — Movex REST API ─────────────────────────────────────────────────────
MOVEX_API_URL=http://srxwebapp1.srxglobal.local/api
MOVEX_API_KEY=change-me-dev-only

# ── Supplier APIs (S3-3) ──────────────────────────────────────────────────────
# DigiKey: https://developer.digikey.com — create sandbox app for dev
# Leave blank to disable; adapters are skipped if CLIENT_ID is unset.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_BASE_URL=https://api.digikey.com

# Nexar: https://nexar.com/api — Starter tier: 100 parts/month free
#        Standard 2025: $100/month for 2,000 matched parts/month
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# ── Supplier cache TTLs (split by field class — migration 0033) ──────────────
# Descriptive fields (description, manufacturer, category, lifecycle,
# mounting_type): what a part IS. Stable for years.
SUPPLIER_CACHE_TTL_DAYS=30
#
# Commercial fields (unit_price, quantity_available, price_breaks, moq,
# currency): what a part COSTS today. Short TTL for two reasons —
#   1. Distributor terms. DigiKey user agreement §5.1(e) forbids using the API
#      "to update or create your own database of information"; Octopart/Nexar
#      cap caching at 24h. See docs/supplier-api-landscape.md.
#   2. 30-day-old pricing is simply wrong, and stock is wrong within hours.
# Hard ceiling of 24 is enforced in code (chain.py) — a value above it is
# clamped, not honoured. 0 disables commercial caching entirely.
SUPPLIER_COMMERCIAL_CACHE_TTL_HOURS=24

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Comma-separated allowed CORS origins — tighten in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=/api/v1

# ── Container Registry (PRE-10) ───────────────────────────────────────────────
# Harbor hostname confirmed by Manal ~2026-04-17
REGISTRY=apac-plm-ops.srxglobal.local
TAG=latest
